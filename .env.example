APP_NAME="MovieTicket API"
APP_ENV=local
APP_KEY=base64:6Cd3F9J36Gq8zO57f49514G8E1qK0U2o6e23O1i4j7w=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Frontend origin for CORS policy (e.g., Vercel deployment URL or local Vite)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (PostgreSQL local / NeonDB in Production)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=movieticket
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
# For NeonDB set DB_SSLMODE=require. For local docker postgres, set prefer.
DB_SSLMODE=prefer

# NeonDB full connection string (Optional alternative to DB_HOST/DB_DATABASE/etc):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# Laravel Sanctum Token Auth
# ==============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION=null

# Optional seed toggle on entrypoint boot
RUN_SEEDERS=true

